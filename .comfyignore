# Demo & documentation assets. The READMEs reference these via absolute
# GitHub raw URLs, so they are not needed inside the published registry
# package — excluding doc/ shrinks the package from ~20 MB to ~1.5 MB.
doc/

# Local dev artifacts & previews (not part of the runtime extension)
*.html
*.zip
original-palette-extracted.json
comfyui-palette-v2.json

# Local drafts, agent workspaces, caches and development-only checks
README*.preview.*
README*.draft.*
readme-preview*
.zcode/
.mimosa/
.ruff_cache/
.pytest_cache/
.mypy_cache/
__pycache__/
*.pyc
playwright-report/
test-results/
test/
代码质量报告.md
.zcodeignore
